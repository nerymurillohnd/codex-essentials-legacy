{
  "name": "codex-essentials",
  "version": "1.0.0",
  "description": "Community marketplace for Codex skills and plugins.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "tsc": "tsc --noEmit",
    "typecheck": "node scripts/typecheck.cjs",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json --pretty false",
    "test": "vitest run --passWithNoTests --coverage",
    "test:watch": "vitest --passWithNoTests",
    "validate:plugins": "node scripts/validate-plugins.cjs",
    "validate:github-labels": "node scripts/validate-github-labels.cjs",
    "validate:release-contract": "node scripts/validate-release-contract.cjs",
    "generate:marketplace": "node scripts/generate-marketplace.cjs",
    "validate:marketplace": "node scripts/validate-marketplace.cjs",
    "documentation:gate": "node scripts/documentation-gate.cjs",
    "marketplace:check": "npm run validate:plugins && npm run validate:marketplace",
    "marketplace:build": "npm run validate:plugins && npm run generate:marketplace && npm run validate:marketplace",
    "project:bootstrap": "node scripts/project-bootstrap.cjs",
    "check": "npm run format:check && npm run lint -- --max-warnings=0 && npm run lint:markdown && npm run typecheck && npm run typecheck:scripts && npx tsc6 --noEmit && npm run test && npm run validate:github-labels && npm run validate:release-contract && npm run marketplace:check"
  },
  "keywords": [],
  "author": "Nery Samuel Murillo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nerymurillohnd/codex-essentials.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{ts,tsx,mts,cts,json,jsonc,yaml,yml}": [
      "prettier --write"
    ],
    "*.{md,markdown}": [
      "prettier --write",
      "markdownlint-cli2 --fix --no-globs --"
    ],
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "git-format-staged": "^4.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "pretty-quick": "^4.2.2",
    "simple-git-hooks": "^2.14.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "smol-toml": "1.8.0"
  },
  "dependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-language-server": "^6.0.0"
  }
}
