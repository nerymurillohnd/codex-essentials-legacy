#!/usr/bin/env bash
set -euo pipefail

git-format-staged -f 'prettier --ignore-unknown --stdin --stdin-filepath "{}"' .

staged_files="$(mktemp)"
trap 'rm -f "${staged_files}"' EXIT
git diff --cached --name-only -z --diff-filter=ACMR >"${staged_files}"

while IFS= read -r -d '' file; do
  case "${file}" in
  *.sh | *.bash | .husky/*)
    if [[ "${file}" == .husky/_/* ]]; then
      continue
    fi
    shellcheck -- "${file}"
    shfmt -d -- "${file}"
    ;;
  *.py)
    uvx ruff@0.16.6 check -- "${file}"
    uvx ruff@0.16.6 format --check -- "${file}"
    ;;
  *) ;;
  esac
done <"${staged_files}"
